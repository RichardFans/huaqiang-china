---
const { rows, en = false } = Astro.props;
const tierZh = { hall: '殿堂级', hot: '热门', rising: '新晋', seed: '种子' };
const formZh = {
  source: '原片段', clip: '剧情剪辑', guichu: '鬼畜', yinmad: '音MAD',
  'ai-cover': 'AI翻唱', 'ai-video': 'AI视频', 'ai-other': 'AI其他', other: '其他',
};
const fmt = (n) => (n == null ? '—' : n.toLocaleString('en-US'));
---
<table>
  <thead>
    {en ? (
      <tr><th>Title</th><th>Creator</th><th>Published</th><th class="num">Views</th><th class="num">Coins</th><th>Tags</th></tr>
    ) : (
      <tr><th>标题</th><th>UP主</th><th>发布</th><th class="num">播放</th><th class="num">硬币</th><th>标记</th></tr>
    )}
  </thead>
  <tbody>
    {rows.map((x) => (
      <tr>
        <td style="max-width:340px">
          <a href={x.url} target="_blank" rel="noopener">{x.title}</a>
          {x.status !== 'ok' && <span class="badge b-seed">已失效</span>}
        </td>
        <td style="white-space:nowrap">
          <a href={`https://space.bilibili.com/${x.owner.mid}`} target="_blank" rel="noopener">{x.owner.name}</a>
        </td>
        <td style="white-space:nowrap">{x.pubdate.slice(0, 10)}</td>
        <td class="num">{fmt(x.latest?.view)}</td>
        <td class="num">{fmt(x.latest?.coin)}</td>
        <td style="white-space:nowrap">
          <span class={`badge b-${x.tier}`}>{en ? x.tier : tierZh[x.tier]}</span>{' '}
          {(x.form.startsWith('ai')) && <span class="badge b-ai">{en ? 'AI' : formZh[x.form]}</span>}{' '}
          {x.review !== 'confirmed' && (
            <span class="badge b-pending" title={en ? 'Auto-catalogued, awaiting human review (ADR-0006)' : '自动入册，待人工复核（ADR-0006 评审门控）'}>
              {en ? 'pending' : '⚠ 待复核'}
            </span>
          )}
        </td>
      </tr>
    ))}
  </tbody>
</table>
