---
import Base from '../../layouts/Base.astro';
import WorkList from '../../components/WorkList.astro';
import views from '../../data/generated/views.json';
import { withBase } from '../../lib/base';
import { fmtCn } from '../../lib/format';

export function getStaticPaths() {
  return Object.keys(views['by-scene']).map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const sceneZh: Record<string, string> = {
  maigua: '华强买瓜',
  'song-laohu-banquet': '宋老虎请客',
  'feng-biao': '封彪桥段',
  'zhengfu-other': '其他征服名场面',
  crossover: '跨素材联动',
};
const sceneEn: Record<string, string> = {
  maigua: 'The Watermelon Scene',
  'song-laohu-banquet': 'Song Laohu’s Banquet',
  'feng-biao': 'Feng Biao Scenes',
  'zhengfu-other': 'Other Scenes',
  crossover: 'Crossover',
};
const rows: any[] = views['by-scene'][slug] || [];
const totalView = rows.reduce((s, x) => s + (x.latest?.view || 0), 0);
const date = views.generated_at.slice(0, 10);
// schema.org ItemList + VideoObject（结构化数据）
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${sceneZh[slug]} · 征服二创宇宙档案`,
  numberOfItems: rows.length,
  itemListElement: rows.slice(0, 30).map((x, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'VideoObject',
      name: x.title,
      url: x.url,
      uploadDate: x.pubdate,
      author: { '@type': 'Person', name: x.owner.name },
      interactionStatistic: x.latest
        ? {
            '@type': 'InteractionCounter',
            interactionService: { '@type': 'WebSite', name: 'Bilibili' },
            interactionType: 'https://schema.org/WatchAction',
            userInteractionCount: x.latest.view,
          }
        : undefined,
    },
  })),
};
---

<Base
  title={sceneZh[slug]}
  description={`${sceneZh[slug]}：${rows.length} 条在册二创，累计播放 ${fmtCn(totalView)}。`}
  current={`/scene/${slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <h1 class="page-title">{sceneZh[slug]}</h1>
  <p class="page-lede">
    {sceneEn[slug]}。{rows.length} 条在册作品，累计播放 {fmtCn(totalView)}，按播放量排序；数据快照
    <span class="nowrap num">{date}</span>（UTC）。
  </p>
  <WorkList rows={rows} eager={4} />
  <p class="footnote">
    在册条目均为自动入册、待人工复核；归属仅靠检索词命中的条目置信度较低，复核优先。
    <a href={withBase('/chronicle/')}>编年</a>、<a href={withBase('/creators/')}>UP主</a>、<a
      href={withBase('/graph/')}>图谱</a>
  </p>
</Base>
