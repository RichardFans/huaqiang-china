---
import '../styles/global.css';
import { REPO, repoBlob, withBase } from '../lib/base';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  en?: boolean;
  /** 当前页路径（如 /scene/maigua/），用于导航高亮 */
  current?: string;
}

const { title, description, lang = 'zh-CN', en = false, current = '' } = Astro.props;
const siteName = '征服二创宇宙档案';
const siteNameEn = 'The Conquest Remix Archive';

const nav: [string, string][] = en
  ? [
      ['/en/', 'Home'],
      ['/scene/maigua/', 'Watermelon scene'],
      ['/scene/song-laohu-banquet/', 'Banquet scene'],
      ['/scene/feng-biao/', 'Feng Biao scene'],
      ['/creators/', 'Creators'],
      ['/graph/', 'Graph'],
      ['/chronicle/', 'Chronicle'],
      ['/', '中文'],
    ]
  : [
      ['/', '首页'],
      ['/scene/maigua/', '华强买瓜'],
      ['/scene/song-laohu-banquet/', '宋老虎请客'],
      ['/scene/feng-biao/', '封彪桥段'],
      ['/creators/', 'UP主'],
      ['/graph/', '图谱'],
      ['/chronicle/', '编年'],
      ['/about/', '关于'],
      ['/en/', 'English'],
    ];
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} · ${siteNameEn}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- B 站图床对非常规 Referer 返回 403：封面一律 no-referrer 引用（ADR-0007） -->
    <meta name="referrer" content="no-referrer" />
    <title>{fullTitle}</title>
    <meta name="description" content={description || '《征服》(2003) 二创生态的收集、整理与跟踪：名场面谱系、作品数据档案、热度追踪与研究笔记。'} />
    <meta property="og:title" content={title || siteName} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description || 'The Conquest (2003) remix universe archive'} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="新收录 New entries (中文)" href={withBase('/feeds/new.rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title="New entries (English)" href={withBase('/feeds/new.en.rss.xml')} />
    <link rel="alternate" type="application/atom+xml" title="Atom" href={withBase('/feeds/atom.xml')} />
    <link rel="alternate" type="application/json" title="JSON Feed" href={withBase('/feeds/feed.json')} />
  </head>
  <body>
    <a class="skip" href="#main">{en ? 'Skip to content' : '跳到正文'}</a>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href={en ? withBase('/en/') : withBase('/')}>
          <span class="melon" aria-hidden="true">🍉</span>{siteName}<small>{siteNameEn}</small>
        </a>
        <nav class="nav" aria-label={en ? 'Primary' : '主导航'}>
          {
            nav.map(([href, label]) => (
              <a href={withBase(href)} aria-current={href === current ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main" class="wrap page">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <p>
          {en ? 'Feeds' : '订阅'}：<a href={withBase('/feeds/new.rss.xml')} rel="alternate" type="application/rss+xml">新收录 RSS</a>、<a
            href={withBase('/feeds/new.en.rss.xml')} rel="alternate" type="application/rss+xml">New entries RSS (EN)</a
          >、<a href={withBase('/feeds/movers.rss.xml')} rel="alternate" type="application/rss+xml">{en ? 'Weekly movers' : '周涨幅榜'}</a>、<a
            href={withBase('/feeds/atom.xml')} rel="alternate" type="application/atom+xml">Atom</a
          >、<a href={withBase('/feeds/feed.json')} rel="alternate" type="application/json">JSON Feed</a>
        </p>
        <p>
          {en
            ? 'Metadata and links only. Copyright of the videos remains with the original rights holders and creators. '
            : '本档案仅收录元数据与链接，视频内容版权归原权利人与创作者所有。采集遵循 '}
          {en ? 'Collection follows the ' : ''}
          <a href={repoBlob('docs/decisions/0002-collection-legal-posture.md')}>
            {en ? 'compliance posture' : '合规姿态'}
          </a>
          {en ? ' (browser-equivalent access, metadata only, rate limited, takedown honored). ' : '（浏览器等价访问、仅元数据、限速、可叫停）。'}
          {en ? 'Counts are point-in-time snapshots. ' : '数据为时点快照，抓取时间见各条目。'}
          {en ? 'Content ' : '内容 '}
          <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>{en ? ', code MIT. ' : '，代码 MIT。'}
          <a href={REPO}>{en ? 'Source and data' : '源码与数据'}</a>
        </p>
      </div>
    </footer>

    <script>
      // 封面加载回退（ADR-0007）：规格化地址失败 → 原图；原图也失败 → 显示占位文案。
      // 资源加载错误不冒泡，必须在捕获阶段监听。
      document.addEventListener(
        'error',
        (ev) => {
          const img = ev.target;
          if (!(img instanceof HTMLImageElement)) return;
          if (img.dataset.fallback && img.dataset.tried !== '1') {
            img.dataset.tried = '1';
            img.removeAttribute('srcset');
            img.src = img.dataset.fallback;
            return;
          }
          img.style.visibility = 'hidden';
          img.closest('.thumb, .tile')?.classList.add('is-broken');
        },
        true,
      );
    </script>
  </body>
</html>
